prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: fdpio
Description: Fusion Data Platform I/O library for XRootD access
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lfdpio -lXrdCl -lXrdUtils
Cflags: -I${includedir}
